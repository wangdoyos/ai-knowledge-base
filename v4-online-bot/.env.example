# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，切勿提交）

# ===== LLM（管线分析/审核用）=====
DEEPSEEK_API_KEY=
# 可选：LLM_PROVIDER=deepseek / qwen / openai
LLM_PROVIDER=deepseek
# 可选：覆盖默认模型（默认 deepseek-chat）
# LLM_MODEL=

# ===== 采集策略（可选，默认 5 = lite 档）=====
# PLANNER_TARGET_COUNT=5

# ===== QQ 机器人推送凭据（可选）=====
QQ_AppID=
QQ_AppSecret=
QQ_CHANNEL_ID=
